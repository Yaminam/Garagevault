# Copy to .env.local and fill in. The app reads these at build and runtime.
#
# Both public values ship in the browser bundle by design. They are NOT what
# protects the vault: every row is AES-256-GCM ciphertext encrypted in the
# browser under the master password, so these keys alone reveal nothing.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side only. Bypasses row-level security, used by the seeding tools
# (npm run seed / seed:invoices). Never prefix with NEXT_PUBLIC_ and never
# set it in a browser-exposed environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
